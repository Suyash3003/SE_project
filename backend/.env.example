# ==========================================
# PaintFlow.ai Production & Dev Environment Template
# ==========================================

# Environment mode: development | staging | production
ENVIRONMENT=production

# Strong secret key for JWT signing (minimum 32 characters, recommended 64-char hex)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# Narrative simulation date (YYYY-MM-DD)
APP_SIMULATION_DATE=2025-10-10

# AI Copilot timeout in seconds
COPILOT_TIMEOUT=3.0

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://paintflow.yourdomain.com,http://localhost:5173

# SQLite database file path (optional, defaults to backend/data/paintflow.db)
DATABASE_PATH=

# Optional Google Gemini API key for AI Copilot (if omitted, copilot uses safe heuristic fallback)
GEMINI_API_KEY=

# Gemini model for the copilot. Override this only with a model enabled for
# your Gemini API project.
GEMINI_MODEL=gemini-2.5-flash

# Optional SMTP Configuration for email verification & password reset
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@paintflow.ai
